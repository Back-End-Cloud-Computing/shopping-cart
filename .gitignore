# Dependencies
node_modules/

# Environment variables (JWT secrets, Redis URL)
# .env.example is intentionally tracked — it serves as a template.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Redis data (if running redis-server at the project root instead of the container)
dump.rdb
appendonly.aof
appendonlydir/

# Tool caches
.npm/
.eslintcache

# Runtime
*.pid
*.pid.lock

# Packages generated by `npm pack`
*.tgz

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
